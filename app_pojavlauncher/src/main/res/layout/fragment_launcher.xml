<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background_app">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/ember_panel" android:clipToOutline="true">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ember_world" android:scaleType="centerCrop" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="22dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_java" android:textSize="10sp" android:textColor="@color/minebutton_color" android:letterSpacing="0.18" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_hero_title" android:textSize="32sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp" android:lineSpacingExtra="-3dp"/>
                    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_hero_caption" android:textSize="12sp" android:textColor="@color/secondary_text"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_workspace" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:letterSpacing="0.12"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/custom_control_button" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="@string/ember_controls" android:drawableStart="@drawable/ic_menu_custom_controls"/>
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="@string/ember_install" android:drawableStart="@drawable/ic_menu_install_jar"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="@string/ember_files" android:drawableStart="@drawable/ic_folder"/>
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="@string/ember_logs" android:drawableStart="@drawable/ember_share"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/news_button" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="@string/ember_guide" android:drawableStart="@drawable/ember_help"/>
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/discord_button" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="@string/ember_project" android:drawableStart="@drawable/ember_layers"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/ember_launch_dock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ember_panel" android:padding="14dp" android:layout_margin="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_selected_instance" android:textSize="10sp" android:textColor="@color/secondary_text" android:letterSpacing="0.12"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
            <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:drawableEnd="@drawable/ember_expand" app:drawableEndSize="18dp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:drawablePadding="10dp" app:drawableStartSize="32dp" app:drawableStartIntegerScaling="false"/>
            <ImageButton android:id="@+id/edit_profile_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/ic_edit_profile" android:background="@drawable/ember_icon_button" android:contentDescription="@string/ember_edit_instance"/>
        </LinearLayout>
        <com.kdt.mcgui.MineButton android:id="@+id/play_button" android:tag="ember_primary" android:layout_width="match_parent" android:layout_height="54dp" android:text="@string/main_play" android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
