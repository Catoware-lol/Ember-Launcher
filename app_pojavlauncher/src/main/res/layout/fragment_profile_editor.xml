<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background_app">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:background="@color/background_app">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_library" android:textSize="11sp" android:textColor="@color/minebutton_color" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_edit_instance" android:textSize="22sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
            <ImageView android:id="@+id/vprof_editor_profile_icon" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ember_mark" android:background="@drawable/ember_icon_button" android:layout_marginTop="20dp" android:contentDescription="@string/ember_instance_icon"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profiles_profile_name" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/vprof_editor_profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@drawable/background_line" android:padding="14dp" android:hint="@string/unnamed" android:textSize="15sp" android:inputType="textPersonName" android:singleLine="true"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profiles_profile_version" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/vprof_editor_version_spinner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical" android:background="@drawable/background_line" android:padding="14dp" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
                <Button android:id="@+id/vprof_editor_version_button" android:layout_width="80dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="@string/global_select"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_instance_tuning" android:textSize="11sp" android:textColor="@color/minebutton_color"  android:layout_marginTop="28dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/default_control" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/vprof_editor_ctrl_spinner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical" android:background="@drawable/background_line" android:padding="14dp" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
                <Button android:id="@+id/vprof_editor_ctrl_button" android:layout_width="80dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="@string/global_select"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pvc_jvmArgs" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/vprof_editor_jre_args" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@drawable/background_line" android:padding="14dp" android:hint="@string/use_global_default" android:textSize="15sp" android:inputType="textMultiLine"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_game_directory" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/vprof_editor_path" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical" android:background="@drawable/background_line" android:padding="14dp" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
                <Button android:id="@+id/vprof_editor_path_button" android:layout_width="80dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="@string/global_select"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pedit_java_runtime" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <Spinner android:id="@+id/vprof_editor_spinner_runtime" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/background_line" android:paddingHorizontal="12dp" android:popupBackground="@drawable/ember_panel"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pedit_renderer" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
            <Spinner android:id="@+id/vprof_editor_profile_renderer" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/background_line" android:paddingHorizontal="12dp" android:popupBackground="@drawable/ember_panel"/>
            <CheckBox android:id="@+id/vprof_editor_profile_angle" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/use_angle_checkbox"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="horizontal">
        <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_save_button" android:tag="ember_primary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="@string/global_save"/>
        <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_delete_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="@string/global_delete"/>
    </LinearLayout>
</LinearLayout>
