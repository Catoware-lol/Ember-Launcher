<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_identity" android:textSize="11sp" android:textColor="@color/minebutton_color" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_auth_title" android:textSize="22sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_auth_body" android:textSize="14sp" android:textColor="@color/secondary_text" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
        <com.kdt.mcgui.MineButton android:id="@+id/button_local_authentication" android:tag="ember_primary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/ember_offline_profile" />
        <com.kdt.mcgui.MineButton android:id="@+id/button_microsoft_authentication" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/ember_microsoft" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_auth_footer" android:textSize="12sp" android:textColor="@color/secondary_text" android:layout_marginTop="24dp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>