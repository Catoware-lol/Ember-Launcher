<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_app">
<net.kdt.pojavlaunch.customcontrols.ControlLayout android:id="@+id/customctrl_controllayout" android:layout_width="match_parent" android:layout_height="match_parent"/>
<View android:id="@+id/editor_preview_shield" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:visibility="gone"/>
<LinearLayout android:id="@+id/editor_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:background="@color/background_bottom_bar" android:elevation="4dp" android:padding="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<ImageButton android:id="@+id/editor_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/ember_chevron" android:rotation="180" android:background="?attr/selectableItemBackground" android:contentDescription="@string/ember_editor_title"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="4dp" android:text="@string/ember_editor_title" android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
<Button android:id="@+id/editor_add" android:layout_width="wrap_content" android:minWidth="48dp" android:layout_height="48dp" android:text="@string/ember_editor_add" android:textAllCaps="false" style="@style/Widget.AppCompat.Button.Borderless"/>
<Button android:id="@+id/editor_save" android:layout_width="wrap_content" android:minWidth="48dp" android:layout_height="48dp" android:text="@string/global_save" android:textAllCaps="false" style="@style/Widget.AppCompat.Button.Borderless"/>
<Button android:id="@+id/editor_preview" android:layout_width="wrap_content" android:minWidth="48dp" android:layout_height="48dp" android:text="@string/ember_editor_preview" android:textAllCaps="false" style="@style/Widget.AppCompat.Button.Borderless"/>
<Button android:id="@+id/editor_more" android:layout_width="wrap_content" android:minWidth="48dp" android:layout_height="48dp" android:text="@string/ember_editor_more" android:textAllCaps="false" style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingBottom="6dp" android:text="@string/ember_editor_hint" android:textColor="@color/secondary_text" android:textSize="12sp"/>
</LinearLayout>
<Button android:id="@+id/editor_show_tools" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:text="@string/ember_editor_show" android:textAllCaps="false" android:visibility="gone"/>
</FrameLayout>