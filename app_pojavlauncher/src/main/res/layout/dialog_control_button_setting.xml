<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/edit_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:id="@+id/editName_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:paddingEnd="5dp" android:text="@string/global_name" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <EditText android:id="@+id/editName_editText" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:hint="Button Name" android:imeOptions="flagNoExtractUi" android:maxLines="1" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" android:singleLine="true" android:layout_marginBottom="8dp" />
  <TextView android:id="@+id/editSize_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:paddingEnd="5dp" android:text="@string/customctrl_size" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <EditText android:id="@+id/editSize_editTextX" android:layout_width="0dp" android:layout_height="48dp" android:gravity="center_vertical" android:imeOptions="flagNoExtractUi" android:inputType="numberDecimal" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" android:singleLine="true" android:layout_marginBottom="8dp" android:layout_weight="1" />
    <TextView android:id="@+id/editSize_x_textView" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:text="x" android:textSize="14sp" android:layout_marginTop="0dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
    <EditText android:id="@+id/editSize_editTextY" android:layout_width="0dp" android:layout_height="48dp" android:gravity="center_vertical" android:imeOptions="flagNoExtractUi" android:inputType="numberDecimal" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" android:singleLine="true" android:layout_marginBottom="8dp" android:layout_weight="1" />
  </LinearLayout>
  <TextView android:id="@+id/editMapping_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingEnd="5dp" android:text="@string/customctrl_mapping" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:gravity="start" android:textColor="@color/secondary_text" />
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
    <Spinner android:id="@+id/editMapping_spinner_1" android:layout_width="match_parent" android:layout_height="48dp" android:dropDownWidth="match_parent" android:dropDownVerticalOffset="30dp" android:gravity="center_vertical" android:visibility="invisible" android:background="@android:color/transparent" android:textSize="14sp" />
    <TextView android:id="@+id/mapping_1_textview" style="?android:attr/spinnerItemStyle" android:layout_width="match_parent" android:layout_height="48dp" android:ellipsize="marquee" android:gravity="center_vertical" android:textAlignment="inherit" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" />
  </FrameLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
    <Spinner android:id="@+id/editMapping_spinner_2" android:layout_width="match_parent" android:layout_height="48dp" android:dropDownWidth="match_parent" android:dropDownHorizontalOffset="30dp" android:dropDownVerticalOffset="30dp" android:gravity="center_vertical" android:visibility="invisible" android:background="@android:color/transparent" android:textSize="14sp" />
    <TextView android:id="@+id/mapping_2_textview" style="?android:attr/spinnerItemStyle" android:layout_width="match_parent" android:layout_height="48dp" android:ellipsize="marquee" android:gravity="center_vertical" android:textAlignment="inherit" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" />
  </FrameLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
    <Spinner android:id="@+id/editMapping_spinner_3" android:layout_width="match_parent" android:layout_height="48dp" android:dropDownWidth="match_parent" android:dropDownVerticalOffset="30dp" android:gravity="center_vertical" android:visibility="invisible" android:background="@android:color/transparent" android:textSize="14sp" />
    <TextView android:id="@+id/mapping_3_textview" style="?android:attr/spinnerItemStyle" android:layout_width="match_parent" android:layout_height="48dp" android:ellipsize="marquee" android:gravity="center_vertical" android:textAlignment="inherit" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" />
  </FrameLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
    <Spinner android:id="@+id/editMapping_spinner_4" android:layout_width="match_parent" android:layout_height="48dp" android:dropDownWidth="match_parent" android:dropDownVerticalOffset="30dp" android:visibility="invisible" android:background="@android:color/transparent" android:textSize="14sp" android:gravity="center_vertical" />
    <TextView android:id="@+id/mapping_4_textview" style="?android:attr/spinnerItemStyle" android:layout_width="match_parent" android:layout_height="48dp" android:ellipsize="marquee" android:gravity="center_vertical" android:textAlignment="inherit" android:textSize="14sp" android:background="@drawable/background_line" android:padding="12dp" />
  </FrameLayout>
  <TextView android:id="@+id/editOrientation_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="start" android:paddingEnd="5dp" android:text="@string/customctrl_orientation" android:textSize="14sp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <Spinner android:id="@+id/editOrientation_spinner" android:layout_width="match_parent" android:layout_height="48dp" android:background="@android:color/transparent" android:textSize="14sp" android:gravity="center_vertical" />
  <Switch android:id="@+id/checkboxToggle" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_toggle" android:textSize="14sp" android:gravity="center_vertical" />
  <Switch android:id="@+id/checkboxPassThrough" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_passthru" android:textSize="14sp" android:gravity="center_vertical" />
  <Switch android:id="@+id/checkboxSwipeable" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_swipeable" android:textSize="14sp" android:gravity="center_vertical" />
  <Switch android:id="@+id/checkboxForwardLock" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_forward_lock" android:textSize="14sp" android:gravity="center_vertical" />
  <Switch android:id="@+id/checkboxAbsoluteFingerTracking" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_absolute_tracking" android:textSize="14sp" android:gravity="center_vertical" />
  <fr.spse.extended_view.ExtendedTextView android:id="@+id/editBackgroundColor_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:drawableEnd="@drawable/spinner_arrow_right" android:gravity="center_vertical" android:paddingEnd="5dp" android:text="@string/customctrl_background_color" android:textSize="14sp" />
  <TextView android:id="@+id/editStrokeWidth_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="start" android:paddingEnd="5dp" android:text="@string/customctrl_stroke_width" android:textSize="14sp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <SeekBar android:id="@+id/editStrokeWidth_seekbar" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="14sp" />
  <TextView android:id="@+id/editStrokeWidth_textView_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="100%" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <fr.spse.extended_view.ExtendedTextView android:id="@+id/editStrokeColor_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:drawableEnd="@drawable/spinner_arrow_right" android:gravity="center_vertical" android:paddingEnd="5dp" android:text="@string/customctrl_stroke_color" android:textSize="14sp" />
  <TextView android:id="@+id/editCornerRadius_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:paddingEnd="5dp" android:text="@string/customctrl_corner_radius" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <SeekBar android:id="@+id/editCornerRadius_seekbar" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="14sp" />
  <TextView android:id="@+id/editCornerRadius_textView_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="100%" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <TextView android:id="@+id/editButtonOpacity_textView" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:paddingEnd="5dp" android:text="@string/customctrl_button_opacity" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <SeekBar android:id="@+id/editButtonOpacity_seekbar" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="14sp" />
  <TextView android:id="@+id/editButtonOpacity_textView_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="100%" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="@color/secondary_text" />
  <TextView android:id="@+id/visibility_textview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/customctrl_visibility_title" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:gravity="start" android:textColor="@color/secondary_text" />
  <CheckBox android:id="@+id/visibility_game_checkbox" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_visibility_ingame" android:textSize="14sp" android:gravity="center_vertical" />
  <CheckBox android:id="@+id/visibility_menu_checkbox" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/customctrl_visibility_in_menus" android:textSize="14sp" android:gravity="center_vertical" />
</LinearLayout>