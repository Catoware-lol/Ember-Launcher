<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_library" android:textSize="11sp" android:textColor="@color/minebutton_color"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_modpack_title" android:textSize="28sp" android:textColor="@color/primary_text" android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ember_modpack_body" android:textSize="14sp" android:textColor="@color/secondary_text" android:layout_marginTop="12dp"/>
        <com.kdt.mcgui.MineButton android:id="@+id/button_browse_modpacks" android:tag="ember_primary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="@string/ember_browse_modpacks"/>
        <com.kdt.mcgui.MineButton android:id="@+id/button_import_modpack" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="@string/ember_import_modpack"/>
    </LinearLayout>
</ScrollView>
